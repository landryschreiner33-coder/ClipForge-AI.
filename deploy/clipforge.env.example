# ClipForge cloud mode — example environment. Copy to /etc/clipforge/clipforge.env (chmod 600).
# This file holds NO secrets: the OIDC client secret and the encryption key live in their own files (see below).
CLIPFOUNDRY_MODE=cloud

# The address people open, scheme and host only. Plain http is accepted only for localhost testing.
CLIPFOUNDRY_PUBLIC_URL=https://studio.example.com
# Hosts the server answers for (defaults to the host of CLIPFOUNDRY_PUBLIC_URL).
CLIPFOUNDRY_ALLOWED_HOSTS=studio.example.com
# The reverse proxy in front of ClipForge (its X-Forwarded-For is trusted only from these addresses).
CLIPFOUNDRY_TRUSTED_PROXIES=127.0.0.1,::1

# Sign-in: an OpenID Connect provider. Google works directly: create an OAuth "Web application" client with the
# redirect URI https://studio.example.com/api/auth/callback .
CLIPFOUNDRY_OIDC_ISSUER=https://accounts.google.com
CLIPFOUNDRY_OIDC_CLIENT_ID=REPLACE-ME.apps.googleusercontent.com
CLIPFOUNDRY_OIDC_CLIENT_SECRET_FILE=/etc/clipforge/oidc-client-secret
# Who may sign in: issuer|subject of the owner's account (the stable "sub" claim, never an email address).
# The first entry opens the primary workspace (the migrated desktop data).
CLIPFOUNDRY_OWNER_SUBJECTS=https://accounts.google.com|REPLACE-WITH-YOUR-SUB
# Must stay off until multi-user isolation is verified.
CLIPFOUNDRY_PUBLIC_SIGNUP=off

# 32 random bytes, outside the data folder, chmod 600:  openssl rand -base64 32 > /etc/clipforge/secret.key
CLIPFOUNDRY_SECRET_KEY_FILE=/etc/clipforge/secret.key

# Data on the persistent disk (never a network filesystem: SQLite needs local locking).
CLIPFOUNDRY_DATA=/var/lib/clipforge
CLIPFOUNDRY_PORT=8765
# Limits (gigabytes) and session lengths (hours).
CLIPFOUNDRY_MAX_UPLOAD_GB=8
CLIPFOUNDRY_STORAGE_LIMIT_GB=150
CLIPFOUNDRY_SESSION_HOURS=12
CLIPFOUNDRY_SESSION_IDLE_HOURS=4
